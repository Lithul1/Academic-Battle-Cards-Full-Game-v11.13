function calcDamage(ch,ab){
  let d=ab.dmg||0;
  if(ab.dmgType==='perTurn') d=(ab.base||0)+arenaGrow(ch,ab);   /* starts at the printed number */
  else if(ab.dmgType==='perABC') d=(ab.step||10)*ch.atkCharge.length;
  else if(ab.dmgType==='perTeamABC') d=(ab.base||0)+(ab.step||10)*teamAbcCount(ch);
  else if(ab.dmgType==='koScale'){ const _P=pileOwnerOf(ch); d=(ab.dmg||ab.base||0)+(ab.step||10)*((_P&&_P.grave)?_P.grave.length:0); }
