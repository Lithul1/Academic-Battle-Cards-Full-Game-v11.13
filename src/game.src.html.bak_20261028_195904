// pileScale — counts cards of the named types in YOUR OWN discard pile.
// grave feeds the KO term only, never the card count, so a death cannot pay twice.
function pileOwnerOf(ch){
  for(const k of ['you','opp']){ const P=S&&S[k]; if(P&&P.team&&P.team.indexOf(ch)>=0) return P; }
  return null;
}
function cardKind(c){
  if(!c) return null;
