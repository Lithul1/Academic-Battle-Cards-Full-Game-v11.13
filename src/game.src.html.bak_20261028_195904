/* the one entry point. ev: {t:'play'|'bookmark'|'charge'|'answer'|'ko'|'koFull'|'lens'|'thesis'|'status'|'evolve'|'siphon'|'win'|'lose'|'boss'|'activeKO', ...} */
function chEvent(st,ev,onDone){
  const M=CHT.match, T=CHT.turn;
