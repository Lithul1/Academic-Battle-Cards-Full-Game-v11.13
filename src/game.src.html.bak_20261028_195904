  const want=[].concat(ps.counts||[]);
  let n=0;
  (P.discard||[]).forEach(c=>{ const k=cardKind(c); if(k&&want.includes(k)) n++; });
  let bonus=n*(ps.step||5);
  if(ps.koStep) bonus += (P.grave?P.grave.length:0)*ps.koStep;
  return Math.min(ps.cap!=null?ps.cap:9999, bonus);
}
function teamAbcCount(ch){
  const P=pileOwnerOf(ch); if(!P) return 0;
