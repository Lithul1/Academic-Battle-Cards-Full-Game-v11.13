/* Spend 1 ABC: after the player's attack resolves, they pick which spent ABC goes to the discard. */
function arenaSpendPrompt(){ const P=S&&S._spendPick; if(!P||busy||S.picker||S.over) return;
  S._spendPick=null; const p=S.you, att=p.team.find(function(c){ return c.uid===P.uid; });
  const pool=att?att.atkCharge.concat(att.blkCharge).filter(function(c){ return P.cids.indexOf(c.cid)>=0; }):[];
  if(!att||att.hp<=0||!pool.length) return;
  const spend=function(cid){ const take=function(arr){ const k=arr.findIndex(function(a){ return a.cid===cid; }); return k>=0?arr.splice(k,1)[0]:null; };
    const x=take(att.atkCharge)||take(att.blkCharge);
    if(x){ p.discard.push(x); pushLog(`${att.name} spends 1 ${x.type==='BLOCK'?'Block':'Attack'} ABC (power ${x.power||1}) \u2014 ${pool.length-1} stay attached.`); } };
  if(pool.length===1){ spend(pool[0].cid); render(); return; }
  askPick(`${att.name} attacked \u2014 which ABC does it spend? The rest stay attached.`,
    pool.map(function(c){ return {label:`${c.type==='BLOCK'?'Block':'Attack'} ABC \u00b7 power ${c.power||1}`, val:c.cid}; }), function(cid){ spend(cid); });
}

/* ---- Offstage entry points (fix_arena_offstage_ui): tap a Backstage character, or the action-bar button ---- */
function arenaOffWhy(p,c){ if(!(S&&S.arena&&ARENA_RULES.offstage)) return 'Offstage is off in this match\u2019s rules.';
  if(S.turn!=='you'||S.phase!=='strategize') return 'Offstage happens during your Strategize phase.';
  if(p.flags._offTurn===(S._turnNo||0)) return 'You have already used Offstage this turn.';
  if(c){ const i=p.team.indexOf(c); if(i===p.activeIdx) return 'Your Active can\u2019t go offstage \u2014 only Backstage characters.';
    if(c._pmCmd && pmReturnCost(c)===null) return `${c.name} has no returns left.`;
    if(!(c.atkCharge.length+c.blkCharge.length) && !p.hand.some(function(h){ return h.cat==='abc'; })) return 'You need 1 ABC to pay \u2014 on this character or in your hand.'; }
  return ''; }
function arenaOffBtn(p,c){ const why=arenaOffOk(p,c)?'':arenaOffWhy(p,c);
  return why?`<div class="bv-ph" style="opacity:.75;margin:.4em 0">\u21e0 Offstage: ${why}</div>`
            :`<button class="bigbtn" data-do="offstage:${c.uid}" style="margin:.4em 0">\u21e0 Send offstage (costs 1 ABC)</button>`; }
function arenaOffstageStart(uid){ if(!S) return; const p=S.you;
  const go=function(c){ const why=arenaOffOk(p,c)?'':arenaOffWhy(p,c); if(why){ toast(why); render(); return; }
    const lab=function(a,where){ return `${a.type==='BLOCK'?'Block':'Attack'} ABC \u00b7 power ${a.power||1} \u2014 ${where}`; };
    const opts=c.atkCharge.concat(c.blkCharge).map(function(a){ return {label:lab(a,'on '+c.name), val:a.cid}; })
      .concat(p.hand.filter(function(h){ return h.cat==='abc'; }).map(function(a){ return {label:lab(a,'from your hand'), val:a.cid}; }));
    if(opts.length===1) arenaOffstage('you',c.uid,opts[0].val);
    else askPick(`Which ABC does ${c.name} discard to go offstage?`, opts, function(cid){ arenaOffstage('you',c.uid,cid); }); };
  if(uid){ const c=p.team.find(function(t){ return t.uid===uid; }); if(c) go(c); return; }
  const gen=arenaOffWhy(p,null); if(gen){ toast(gen); return; }
  const el=p.team.filter(function(c){ return arenaOffOk(p,c); });
  if(!el.length){ toast('No Backstage character can go offstage \u2014 each needs 1 ABC to pay, on it or in your hand.'); return; }
  if(el.length===1){ go(el[0]); return; }
  askPick('Offstage \u2014 which Backstage character?', el.map(function(c){ return {label:`${c.name} (${c.hp}/${c.maxHp} HP, ${c.atkCharge.length+c.blkCharge.length} ABC)`, val:c.uid}; }),
    function(id){ const c=p.team.find(function(t){ return t.uid===id; }); if(c) go(c); }); }

