body.abc-arena[data-screen="play"] .side::before,body.abc-arena[data-screen="play"] .side::after,body.abc-arena[data-screen="play"] .board-inner::before,body.abc-arena[data-screen="play"] .board-inner::after,body.abc-arena[data-screen="play"] .brand{display:none!important}

