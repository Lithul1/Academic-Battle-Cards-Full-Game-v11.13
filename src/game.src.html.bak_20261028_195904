function arenaHasChar(p){ return p.hand.some(function(c){ return c.cat==='char'; }); }
function arenaDig(p){ const i=p.deck.findIndex(function(c){ return c.cat==='char'; }); if(i<0) return;
  const c=p.deck.splice(i,1)[0]; c._new=true; p.hand.push(c);
  pushLog(`${who(p)} has no character after ${ARENA_RULES.mulliganMax} mulligans \u2014 reveals until one: ${c.name}.`); }
