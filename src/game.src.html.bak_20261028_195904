const ABC_FLY_MS=1300;   /* fix_card_play_anim2 -- card-play animation length (ms); every phase scales with it */
function abcFlyRun(snap){
  abcLastHand=S?S.you.hand.slice():null; abcLastS=S;
  if(!snap) return;
  const arena=document.body.classList.contains('abc-arena'), st=arena?document.querySelector('.abc-stage'):null;
  /* fix_card_play_anim3 */ /* flights live in a layer OUTSIDE the board, so a repaint mid-flight cannot delete them */
  let host=document.body, k=1;
  if(st){
    k=parseFloat(st.style.getPropertyValue('--abc-k'))||1;
    host=document.getElementById('abcFlyLayer');
    if(!host){ host=document.createElement('div'); host.id='abcFlyLayer'; document.body.appendChild(host); }
    host.style.width=st.offsetWidth+'px'; host.style.height=st.offsetHeight+'px';
    host.style.transform='translate(-50%,-50%) scale('+k+')';
  }
  const o=st?st.getBoundingClientRect():{left:0,top:0};
  const loc=function(r){ return {x:(r.left+r.width/2-o.left)/k, y:(r.top+r.height/2-o.top)/k, h:r.height/k}; };
  snap.forEach(function(f,i){
    const tgt=abcFlyTarget(f.card); if(!tgt) return;
    const tr=tgt.getBoundingClientRect(); if(!tr.width) return;
    const a=loc(f.r), b=loc(tr);
    const wrap=document.createElement('div'); wrap.className='hand abc-fly-hand';
    wrap.style.width=f.w+'px'; wrap.style.height=f.h+'px'; wrap.appendChild(f.node); host.appendChild(wrap);
    const T=function(x,y){ return 'translate('+(x-f.w/2).toFixed(1)+'px,'+(y-f.h/2).toFixed(1)+'px)'; };
    const sc=Math.max(.35, Math.min(.8, b.h/f.h));
    if(!wrap.animate){ wrap.remove(); return; }
    /* fix_card_play_anim2 */ /* rise -> present (hold) -> fly -> land */
    const PS=1.35, sw=st?st.offsetWidth:window.innerWidth, sh=st?st.offsetHeight:window.innerHeight;
    const half=f.w*PS/2+8, halfh=f.h*PS/2+8;
    const px=Math.max(half, Math.min(sw-half, a.x+(b.x-a.x)*.35));
    const py=Math.max(halfh, Math.min(sh-halfh, Math.min(a.y,b.y)-f.h*.25));
    const an=wrap.animate([
      {transform:T(a.x,a.y)+' scale(1) rotate(0deg)', opacity:1, easing:'cubic-bezier(.2,.8,.3,1)'},
      {transform:T(px,py)+' scale('+PS+') rotate(-2deg)', opacity:1, offset:.23},
      {transform:T(px,py-4)+' scale('+PS+') rotate(0deg)', opacity:1, offset:.54, easing:'cubic-bezier(.55,0,.25,1)'},
      {transform:T(b.x,b.y)+' scale('+sc+') rotate(0deg)', opacity:.95, offset:.89},
      {transform:T(b.x,b.y)+' scale('+(sc*.9)+') rotate(0deg)', opacity:0}
    ], {duration:ABC_FLY_MS, delay:i*Math.round(ABC_FLY_MS*.4), fill:'both'});
    an.onfinish=function(){ wrap.remove();
      const t2=abcFlyTarget(f.card); if(t2){ t2.classList.remove('abc-land'); void t2.offsetWidth; t2.classList.add('abc-land');
        setTimeout(function(){ t2.classList.remove('abc-land'); }, 450); } };
  });
}
// Uniformly scale the board so both sides + controls always fit the play area (no overlap, no scroll)
function fitBoard(){
  document.body.classList.toggle('abc-tilt', abcTiltOn());   /* fix_board_layout_v3 */
  { const ph=abcPhoneOn(); if(document.body.classList.contains('abc-phone')!==ph){ document.body.classList.toggle('abc-phone', ph); fitNames(); } if(ph) document.body.classList.remove('abc-tilt'); }   /* fix_board_layout_v4: refit names after a stage switch */
  document.body.classList.toggle('abc-light', abcLightOn());   /* fix_board_layout_v6 */
  if(abcArenaFit()) return;   /* fix_board_layout_v1 */
  const board=document.querySelector('body[data-screen="play"] .board');
  const inner=board&&board.querySelector('.board-inner');
  if(!board||!inner) return;
  /* single-screen mobile: scale to fit rather than paging */ // pager mode scrolls by design
  inner.style.transform=''; inner.style.width='';
  const availH=board.clientHeight, availW=board.clientWidth;
  const needH=inner.scrollHeight, needW=inner.scrollWidth;
  if(!availH||!needH) return;
  const k=Math.min(1, availH/needH, availW/needW);
  if(k<0.999){
    inner.style.transformOrigin='top center';
    inner.style.transform=`scale(${k})`;
    inner.style.width=(100/k)+'%';           // let content keep its natural width, then shrink uniformly
    inner.style.marginLeft=((1-1/k)*50)+'%'; // recenter the widened box
  } else { inner.style.marginLeft=''; }
}
