/* ---- Transcript Code: portable backup/restore of META progress ----
   LUL2 = positional array (no JSON keys) + prefix-factored editionCards.
   TRANSCRIPT_V2_ORDER is FROZEN and append-only: never reorder or remove entries
   (that would invalidate existing codes) — only add new fields to the end. */
const TRANSCRIPT_FIELDS=['ip','unlocks','perks','loadout','commanders','packs','mhPacks','foils','bossSeen','bossKilled','editionCards','decks','deckCards','crits','bmCopies','honorsMax','honorsCleared','stats','patron','calmFx'];
const TRANSCRIPT_V2_ORDER=['ip','unlocks','perks','loadout','commanders','packs','mhPacks','foils','bossSeen','bossKilled','editionCards','decks','deckCards','crits','bmCopies','honorsMax','honorsCleared','stats','patron','calmFx'];
function transcriptChecksum(str){ let h=5381; for(let i=0;i<str.length;i++){ h=((h*33)^str.charCodeAt(i))>>>0; } return ('0000'+h.toString(36)).slice(-4); }
