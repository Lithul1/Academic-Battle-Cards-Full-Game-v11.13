  if(typeof symbolsOff==='function' && symbolsOff(sideOfChar(ch))) return {amt:ab.block||0};
  if(ab.blockType==='negate') return {amt:incoming,negate:true};
  if(ab.blockType==='capto') return {amt:Math.max(0,incoming-(ab.cap||10))};
  if(ab.blockType==='perTurn') return {amt:(ab.base||0)+arenaGrow(ch,ab)};
