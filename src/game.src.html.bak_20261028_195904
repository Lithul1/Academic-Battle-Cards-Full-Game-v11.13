      [{label:`Draw ${owed}`,val:owed},{label:'No thanks',val:0}],
      function(v){ v=+v||0; for(let k=0;k<v;k++) dealOne('you'); if(v){ S._tel.bonus.A=v; pushLog(`You take ${v} bonus card${v>1?'s':''}.`); } finish(); });
