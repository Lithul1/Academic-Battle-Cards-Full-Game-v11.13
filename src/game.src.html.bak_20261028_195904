// ---- Marginalia: spend an attach, name an ABC in your own discard, answer two
// (three while Smudged) to charge it straight onto your Active. No retry.
function mgEligible(){
  return !!(S && S.turn==='you' && S.phase==='strategize' && !busy
            && S.viewPile==='you' && (S.you.attachesLeft||0)>0 && !drawnLocked());
}
function mgNeed(){ const a=active(S.you); return (a&&a.status&&a.status.smudge)?3:2; }
function mgQuestions(card,n){
  const pool=[];
  const push=c=>{ if(c&&c.cat==='abc'&&c.q&&c.opts&&c.ans!=null) pool.push(c); };
  S.you.deck.forEach(push); S.you.discard.forEach(push); S.you.hand.forEach(push);
  const out=[card];
  const seen=new Set([card.q]);
  const shuffled=pool.slice().sort(()=>Math.random()-0.5);
  for(const c of shuffled){ if(out.length>=n) break; if(seen.has(c.q)) continue; seen.add(c.q); out.push(c); }
  while(out.length<n) out.push(card);           // tiny pools: repeat rather than break
  return out.slice(0,n);
}
function mgSelect(i){
  if(!mgEligible()) return;
  const c=S.you.discard[i];
  if(!c || c.cat!=='abc') return;
  S._mgPick = (S._mgPick===i) ? null : i;
  render();
}
function mgStart(){
  if(!mgEligible() || S._mgPick==null) return;
  const idx=S._mgPick, card=S.you.discard[idx];
  if(!card || card.cat!=='abc'){ S._mgPick=null; render(); return; }
  const need=mgNeed();
  S._mg={idx, card, need, step:0, qs:mgQuestions(card,need)};
  S._mgPick=null; S.viewPile=null;
  busy=true; S.pending={card:S._mg.qs[0], handIdx:-1, target:null, _mg:true};
  pushLog(`${who(S.you)} reaches back into the pile \u2014 ${need} questions to reclaim it.`);
  render();
}
function mgAnswer(choice){
  const st=S._mg; if(!st) return;
  const q=st.qs[st.step], correct=choice===q.ans;
  S.pending=null;
  if(!correct){
    S._mg=null; busy=false;
    S.you.attachesLeft=Math.max(0,(S.you.attachesLeft||0)-1);
    toast('Wrong — the card stays buried.','bad');
    pushLog('The page will not come back. The attach is spent.');
    render(); return;
  }
  st.step++;
  if(st.step<st.need){
    toast(`Correct — ${st.need-st.step} to go.`,'good');
    S.pending={card:st.qs[st.step], handIdx:-1, target:null, _mg:true};
    busy=true; render(); return;
  }
  // all correct — pull it out of the pile and charge it
  const i=S.you.discard.indexOf(st.card);
  if(i>=0) S.you.discard.splice(i,1);
  const act=active(S.you);
  const _snap2=chargeSnap(act);
  (String(st.card.type).toUpperCase()==='ATTACK'?act.atkCharge:act.blkCharge).push(st.card);
  try{ SFX.attach(String(st.card.type).toUpperCase()==='ATTACK'?'atk':'blk'); }catch(e){}
  chargeReport('you', act, _snap2);
  S.you.attachesLeft=Math.max(0,(S.you.attachesLeft||0)-1);
  S._mg=null; busy=false;
  toast('Reclaimed — the card is charged.','good');
  pushLog(`${act.name} reclaims a ${st.card.type} card from the pile.`);
  render();
}

