.char.act3 .pc-art{ border-color:#b8902c; box-shadow:inset 0 0 0 2px #f5e08a; }
.act-curtain{ position:absolute; top:0; bottom:0; width:12%; z-index:3; pointer-events:none;
  background:repeating-linear-gradient(90deg,#6e0f14 0 5px,#9c1c22 5px 9px,#5a0b10 9px 12px); box-shadow:inset 0 -8px 10px rgba(0,0,0,.35); }
.act-curtain.l{ left:0; border-bottom-right-radius:100% 62%; }
.act-curtain.r{ right:0; border-bottom-left-radius:100% 62%; }
.act-valance{ position:absolute; left:0; right:0; top:0; height:12px; z-index:4; pointer-events:none;
  background:radial-gradient(circle at 9px -2px,#9c1c22 8px,transparent 9px) 0 0/18px 12px repeat-x, linear-gradient(#6e0f14,#6e0f14) 0 0/100% 4px no-repeat;
  border-bottom:1px solid rgba(245,224,138,.5); }
/* the evolution moment */
@keyframes actEvoDrop{ 0%{ transform:translateY(-40px) scale(1.08) rotate(-2deg); opacity:0; filter:brightness(1.8); }
  55%{ transform:translateY(4px) scale(.98); opacity:1; filter:brightness(1.25); } 100%{ transform:none; filter:none; } }
