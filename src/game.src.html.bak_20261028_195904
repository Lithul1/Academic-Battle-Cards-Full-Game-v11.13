function deckForPlay(){
  /* Pagemaster plays its own saved deck, kept separate from the Custom one */
  if(pmOn() && APP.pmDeck) return clone(APP.pmDeck);
  if(APP.customDeck) return clone(APP.customDeck);
  if(APP.youDeck==='surprise'){ const k=DECK_ORDER[rnd(DECK_ORDER.length)]; return randomDeck(k); }  // random SET (quick or custom)
  if(APP.mode==='quick') return randomDeck(APP.youDeck);            // quickplay: fresh composition of the chosen set
  return defaultDeck(APP.youDeck);
}
