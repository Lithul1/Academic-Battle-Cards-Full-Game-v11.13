/* ---- Offstage (fix_arena_offstage): once per turn, a Backstage character leaves play ----
   Cost: discard 1 ABC from that character or from your hand. The character goes back to hand with its
   other ABCs. It re-enters later with the damage it left with (min 10 HP) and can't be replayed the same
   turn. An evolved character returns as its base card (Act cards to the discard). A commander's Offstage
   counts as one of its returns; with none left it can't go offstage. */
function arenaOffOk(p,c){ if(!(S&&S.arena&&ARENA_RULES.offstage&&p&&c)) return false;
  if(p.flags._offTurn===(S._turnNo||0)) return false;
  const i=p.team.indexOf(c); if(i<0||i===p.activeIdx||c.hp<=0) return false;
  if(c._pmCmd && pmReturnCost(c)===null) return false;
  return (c.atkCharge.length+c.blkCharge.length)>0 || p.hand.some(function(h){ return h.cat==='abc'; }); }
function arenaOffstage(side,uid,pay){ const p=S&&S[side], c=p&&p.team.find(function(t){ return t.uid===uid; });
  if(!arenaOffOk(p,c)) return false;
  let paid=null;
  if(pay && pay!=='char' && pay!=='hand'){   /* the player named the exact ABC (its cid) */
    const take=function(arr){ const k=arr.findIndex(function(a){ return a.cid===pay; }); return k>=0?arr.splice(k,1)[0]:null; };
    paid=take(c.atkCharge)||take(c.blkCharge)||take(p.hand); if(!paid) return false; }
  else if(pay!=='hand' && (c.blkCharge.length||c.atkCharge.length)) paid=(c.blkCharge.length?c.blkCharge:c.atkCharge).pop();
  else { let k=p.hand.findIndex(function(h){ return h.cat==='abc'&&h.type==='BLOCK'; }); if(k<0) k=p.hand.findIndex(function(h){ return h.cat==='abc'; }); if(k>=0) paid=p.hand.splice(k,1)[0]; }
  if(!paid) return false; p.discard.push(paid);
  const dmg=Math.max(0,c.maxHp-c.hp), cost=c._pmCmd?pmReturnCost(c):0;
  if(c._actBase){ c._offstaging=true; actOnKO(p,c); delete c._offstaging; }
  const back=c.atkCharge.splice(0).concat(c.blkCharge.splice(0)); back.forEach(function(x){ x._new=true; p.hand.push(x); });
  const def=c.fe?firstedById(c.id):((DATA.characters[p.setKey]||[]).find(function(x){ return x.id===c.id; })||c);
  const card={ cat:'char', charId:c.id, name:def.name, accent:def.accent||'#444', hp:def.hp, fe:!!c.fe, _cdef:def,
    cid:'os'+c.id+'_'+Math.random().toString(36).slice(2,6), _offDmg:dmg, _offTurn:(S._turnNo||0), _new:true };
  if(c._pmCmd){ card._pmCmd=true; card._pmReturns=(c._pmReturns||0)+1; card._pmCost=cost; }
  try{ abcPxOffstage(side,c); }catch(e){}   /* fix_pixel_fx4 */
  const i=p.team.indexOf(c); p.team.splice(i,1); if(i<p.activeIdx) p.activeIdx--;
  p.hand.push(card); p.flags._offTurn=(S._turnNo||0);
  if(S._tel){ S._tel.offstage=S._tel.offstage||{A:0,B:0}; S._tel.offstage[p._arenaSide]=(S._tel.offstage[p._arenaSide]||0)+1; }
  pushLog(`${card.name} steps offstage (1 ${paid.type==='BLOCK'?'Block':'Attack'} ABC discarded)`+(back.length?` \u2014 ${back.length} ABC back to hand`:'')+(dmg?` \u2014 carries ${dmg} damage`:'')+'.');
  render(); return true; }
/* AI: when Backstage is full and a host for an Act card in hand is waiting in hand,
   clear the weakest Backstage character that isn't itself a host (commanders kept). */
function arenaAiOffstage(p){ if(!(S.arena&&ARENA_RULES.offstage)||p.flags._offTurn===(S._turnNo||0)) return;
  if(drawnBench(p)<ARENA_RULES.benchMax) return;
  const from=p.hand.filter(function(h){ return h.cat==='act'; }).map(function(h){ const a=actById(h.actId); return a&&a.from; }).filter(Boolean);
  if(!from.length) return;
  if(!p.hand.some(function(h){ return h.cat==='char' && from.indexOf(h.charId)>=0 && h._offTurn==null; })) return;
  const bench=p.team.filter(function(c){ return !c._pmCmd && from.indexOf(actStageId(c))<0 && arenaOffOk(p,c); });
  if(!bench.length) return;
  const pick=bench.sort(function(x,y){ return x.hp-y.hp; })[0];
  arenaOffstage(S.you===p?'you':'opp', pick.uid, (pick.atkCharge.length+pick.blkCharge.length)>0?'char':'hand'); }

