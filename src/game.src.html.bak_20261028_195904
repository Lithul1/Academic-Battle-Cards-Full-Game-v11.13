.code-input{font-family:var(--cond);font-size:13px;padding:8px 11px;border:2px solid var(--ink);border-radius:9px;background:#fff;color:var(--ink);min-width:240px}
.code-msg{min-height:18px;font-family:var(--cond);letter-spacing:.5px;font-size:13px;margin:8px 0 0}
.code-msg.ok{color:#bfe3a8} .code-msg.bad{color:#ff9d8c}
.custom-banner{margin-top:12px;display:inline-flex;gap:8px;align-items:center;background:var(--ink);color:var(--gold);border:2px solid var(--gold);
  border-radius:10px;padding:7px 13px;font-family:var(--cond);letter-spacing:.5px;font-size:13px}
.custom-banner button{background:var(--red);color:var(--cream-hi);border:none;border-radius:6px;padding:3px 9px;font-family:var(--cond);cursor:pointer}

/* ---------- deck builder ---------- */
.builder{max-width:860px;margin:0 auto;padding:14px 14px 70px;color:var(--cream-hi)}
.bd-top{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.bd-top h1{font-family:var(--disp);font-size:26px;margin:0;flex:1;color:var(--cream-hi)}
.bd-setpick{display:flex;gap:6px}
.bd-set{font-family:var(--cond);letter-spacing:1px;text-transform:uppercase;font-size:13px;background:var(--cream);color:var(--ink);border:2px solid var(--ink);border-radius:8px;padding:7px 13px;cursor:pointer}
.bd-set.on{background:var(--gold);box-shadow:0 0 0 2px var(--gold-dk)}
/* ---- Deck-box picker (replaces text buttons) ---- */
.bd-setpick{display:flex;gap:9px;flex-wrap:wrap;padding:4px 0 18px;align-items:flex-start}
.bdx{position:relative;width:60px;padding:0;border:none;background:none;cursor:pointer;transition:transform .16s ease;filter:drop-shadow(0 6px 8px rgba(0,0,0,.45))}
.bdx-im{display:block;border-radius:4px;overflow:hidden;border:1px solid rgba(0,0,0,.5)}
.bdx-im img{display:block;width:100%;height:auto}
.bdx:hover{transform:translateY(-7px) rotate(-1deg)}
.bdx.sel{transform:translateY(-9px)}
.bdx.sel .bdx-im{outline:3px solid #E6B85C;box-shadow:0 0 18px rgba(230,184,92,.6)}
.bdx-bdg{position:absolute;bottom:-9px;left:50%;transform:translateX(-50%);background:#2A211A;color:#E8D49A;border:1px solid #C99B57;font-family:var(--cond);font-weight:800;font-size:.52rem;letter-spacing:.3px;padding:2px 6px;border-radius:9px;white-space:nowrap;max-width:82px;overflow:hidden;text-overflow:ellipsis}
.bdx.sel .bdx-bdg{background:#E6B85C;color:#241c10}
.bdx-dot{position:absolute;top:-5px;right:-5px;background:#1b2540;color:#f4ecd6;border:1.5px solid #f4ecd6;border-radius:9px;font-family:var(--cond);font-weight:800;font-size:9px;padding:0 5px;line-height:15px}
/* fan-down expansion shelf */
.bd-fan{overflow:hidden;max-height:0;transition:max-height .28s ease;background:linear-gradient(#dccfa8,#cbb98c);border:2px dashed #a2905f;border-radius:12px;margin:0 0 14px}
.bd-fan.open{max-height:220px}
.bd-fan-in{padding:13px 15px;display:flex;align-items:center;gap:15px;flex-wrap:wrap}
.bd-fan-lb{font-family:var(--cond);letter-spacing:1px;text-transform:uppercase;font-size:12px;color:#5a4a2a;font-weight:bold}
.ebx{position:relative;width:66px;cursor:pointer;border:none;background:none;padding:0;transition:transform .16s;filter:drop-shadow(0 5px 7px rgba(0,0,0,.4));display:inline-block}
.ebx-im{display:block;border-radius:4px;overflow:hidden;border:1px solid rgba(0,0,0,.5)}
.ebx-im img{display:block;width:100%;height:auto}
.ebx:hover{transform:translateY(-6px)}
.ebx.on{transform:translateY(-8px)}
.ebx.on .ebx-im{outline:3px solid #1b2540;box-shadow:0 0 16px rgba(27,37,64,.65)}
.ebx.flt-all.on .ebx-im{outline-color:#E3A92B;box-shadow:0 0 16px rgba(227,169,43,.6)}
.ebx-bdg{position:absolute;bottom:-9px;left:50%;transform:translateX(-50%);background:#1b2540;color:#f4ecd6;border:1px solid #f4ecd6;font-family:var(--cond);font-weight:800;font-size:.52rem;padding:2px 7px;border-radius:9px;white-space:nowrap}
.ebx.flt-all .ebx-bdg{background:#E3A92B;color:#241c10;border-color:#a97e1e}
.ebx-bdg.lk{background:#6a5a3a;border-color:#8a7a5a}
.ebx.locked{cursor:not-allowed;filter:none}
.ebx.locked:hover{transform:none}
.ebx-lk{display:grid;place-items:center;width:100%;height:92px;border:2px dashed #8a7a5a;border-radius:4px;background:#9a8f76;font-family:var(--disp);font-size:26px;color:#6a5a3a}
.ebx-note{font-family:var(--cond);font-size:13px;color:#4a3a1a;line-height:1.35}
.ebx-note small{color:#6a5a3a}
/* ---- Vault pack shop (Set x Tier) ---- */
.pk-shop{margin-top:14px;border-top:2px dashed #c0ab7d;padding-top:12px}
.pk-shelf{display:flex;gap:9px;flex-wrap:wrap;padding:4px 0 14px}
.pk-box{position:relative;width:66px;padding:0;border:none;background:none;cursor:pointer;transition:transform .16s;filter:drop-shadow(0 6px 8px rgba(0,0,0,.4))}
.pk-im{display:block;border-radius:4px;overflow:hidden;border:1px solid rgba(0,0,0,.5)}
.pk-im img{display:block;width:100%;height:auto}
.pk-im.pk-mono{display:grid;place-items:center;height:96px;background:linear-gradient(160deg,#3a3226,#171310);color:#e8dcc0;font-family:var(--disp);font-size:26px}
.pk-box:hover{transform:translateY(-6px)}
.pk-box.sel{transform:translateY(-8px)}
.pk-box.sel .pk-im{outline:3px solid #E6B85C;box-shadow:0 0 16px rgba(230,184,92,.6)}
.pk-nm{display:block;font-family:var(--cond);font-size:10px;text-align:center;margin-top:9px;color:#5a4a2a;line-height:1.1}
.pk-pr{position:absolute;top:-5px;right:-5px;background:#2A211A;color:#E8D49A;border:1.5px solid #C99B57;border-radius:9px;font-family:var(--cond);font-size:9px;padding:0 5px;line-height:15px}
.pk-hd{font-family:var(--disp);font-size:16px;color:#3a2f18;margin:2px 0 8px}
.pk-hd small{display:block;font-family:var(--cond);font-weight:normal;font-size:12px;color:#7a6a4a;margin-top:2px}
.pk-note{font-family:var(--cond);font-size:12px;color:#6a5a3a;margin-top:9px;padding:7px 10px;background:#f6efd9;border:1.5px dashed #c0ab7d;border-radius:8px}
.vault-buy.dim{opacity:.45}
.pk-box.lk .pk-im img,.bdx.lk .bdx-im img{filter:grayscale(1) brightness(.42)}
.pk-lock,.bdx-lock{position:absolute;inset:0;display:grid;place-items:center;font-size:22px;text-shadow:0 2px 6px rgba(0,0,0,.8)}
.pk-im,.bdx-im{position:relative}
.bdx.lk{filter:none}
.bdx.lk:hover{transform:translateY(-3px)}
.pk-box.lk .pk-pr{background:#6a5a3a;border-color:#8a7a5a}
/* ---- Photosensitivity / eye-strain safety ---- */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}
body.calm-fx *,body.calm-fx *::before,body.calm-fx *::after{animation:none!important}
body.calm-fx .brv{animation:none!important}
body.calm-fx .ready,body.calm-fx .met{box-shadow:0 0 0 3px var(--gold),0 3px 0 var(--red-dk)!important}
body.calm-fx .thinking{opacity:1!important}
/* ---- locked cards in the builder (visible + greyed + hint) ---- */
.bd-chip.lockcard,.bd-bm.lockcard{opacity:.5;filter:grayscale(1);cursor:not-allowed;pointer-events:none;border-style:dashed}
.lk-hint{display:block;font-family:var(--cond);font-size:10px;color:#7a6a4a;margin-top:2px}
.bd-chip.lockcard .bd-nm{color:#5a4a3a}
/* ---- collection meter ---- */
.bd-meter{background:#f6efd9;border:2px solid var(--ink);border-radius:11px;padding:9px 12px;margin:10px 0 4px;box-shadow:0 3px 0 rgba(40,25,12,.35)}
.bdm-hd{font-family:var(--cond);letter-spacing:.5px;font-size:14px;color:#3a2f18}
.bdm-hd b{font-family:var(--disp);font-size:15px}.bdm-hd small{color:#7a6a4a}
.bdm-bar{height:9px;background:#dccfa8;border:1.5px solid var(--ink);border-radius:6px;overflow:hidden;margin:6px 0 5px}
.bdm-bar i{display:block;height:100%;background:linear-gradient(90deg,#E3A92B,#c98b1e)}
.bdm-sub{font-family:var(--cond);font-size:11px;color:#6a5a3a}
.over-ip{font-family:var(--cond);font-size:15px;color:#E3A92B;margin-top:6px}
.over-ip small{display:block;font-size:11px;color:#9d8f6a}
/* ================= STATUS BUBBLES + GLOSSARY (all sizes) ================= */
.sbub{position:absolute;top:-9px;left:-11px;display:flex;flex-direction:column;gap:3px;z-index:16}
.sb{min-width:27px;height:21px;border-radius:11px;padding:0 5px;background:#e07b28;border:2px solid var(--ink);color:#fff;
  font-family:var(--disp);font-size:9px;letter-spacing:.3px;display:grid;place-items:center;cursor:pointer;box-shadow:0 2px 4px rgba(0,0,0,.4)}
.sb.neg{background:#e07b28} .sb.pos{background:#2f7d5c} .sb.key{background:#6B4E8A}
.sb:hover{transform:scale(1.15)}
.stx{max-width:280px}
.stx h4{margin:0 0 6px;font-family:var(--disp);font-size:15px;color:var(--red);display:flex;align-items:center;gap:8px}
.stx-ic{width:25px;height:25px;border-radius:50%;background:#e07b28;border:2px solid var(--ink);color:#fff;display:grid;place-items:center;font-size:11px;flex:none}
.stx p{margin:0 0 8px;font-family:var(--cond);font-size:13px;color:#3a2f18;line-height:1.4}
.stx-fix{background:#e8f2e8;border:1.5px dashed #4a7a4a;border-radius:7px;padding:6px 9px;font-family:var(--cond);font-size:12px;color:#2d5a2d}
/* bench indicator circles — hidden on desktop, shown on mobile */
.bm-hpc,.bm-stc{display:none}
/* ================= MOBILE: SINGLE-SCREEN LAYOUT (overrides the 560px pager) ================= */
.cb-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;border-radius:inherit;display:block}
.cardback .cb-img ~ .cb-medallion,.cardback .cb-img ~ .cb-tag{display:none}
@media (max-width:760px), (pointer:coarse) and (max-width:1400px){
  body[data-screen="play"] #game{padding:4px 6px;gap:3px}
  body[data-screen="play"] .board{
    flex-direction:column;overflow:hidden;scroll-snap-type:none;
    justify-content:space-between;gap:3px;padding-bottom:0;
  }
  body[data-screen="play"] .board::after{content:none!important}
  body[data-screen="play"] .board-inner{display:flex!important;flex-direction:column;width:100%;gap:3px}
  body[data-screen="play"] .board .side{
    min-height:0!important;flex:1;scroll-snap-align:none;
    display:flex;flex-direction:column;justify-content:center;
  }
  body[data-screen="play"] .side-meta{display:block!important;text-align:center;font-size:9px;opacity:.75;margin-bottom:2px}
  body[data-screen="play"] .row{display:flex;align-items:center;justify-content:center;gap:8px}
  body[data-screen="play"] .midline{
    position:static!important;bottom:auto;left:auto;right:auto;z-index:auto;
    flex-direction:row;flex-wrap:wrap;justify-content:center;gap:5px;padding:5px 6px;box-shadow:none;
  }
  body[data-screen="play"] .side .char{flex:0 0 150px!important;width:150px!important;margin:0 auto}
  body[data-screen="play"] .bench-view.char{flex:none!important;width:min(86vw,300px)!important;max-height:88vh;overflow-y:auto}
  body[data-screen="play"] .side .pc-art{height:76px!important}
  body[data-screen="play"] .bench-view .bv-art{height:auto}
  body[data-screen="play"] .side .pc-name{font-size:9px}
  body[data-screen="play"] .side .pc-hp b{font-size:8px}
  body[data-screen="play"] .bench{flex:0 0 56px;width:56px;display:flex;flex-direction:column;gap:6px;align-items:center}
  body[data-screen="play"] .bench-mini{position:relative;width:50px;height:36px;padding:0;border-radius:7px;overflow:visible}
  body[data-screen="play"] .bench-mini .bm-init{width:100%;height:100%;border-radius:5px;overflow:hidden;display:grid;place-items:center}
  body[data-screen="play"] .bench-mini .bm-img{width:100%;height:100%;object-fit:cover}
  body[data-screen="play"] .bench-mini .bm-hp,body[data-screen="play"] .bench-mini .bm-name{display:none}
  body[data-screen="play"] .bm-hpc{display:grid;position:absolute;top:-7px;right:-7px;width:20px;height:20px;border-radius:50%;
    border:2px solid var(--ink);color:#fff;font-family:var(--disp);font-size:8px;place-items:center;z-index:3}
  body[data-screen="play"] .bm-hpc.g{background:#3aa055}
  body[data-screen="play"] .bm-hpc.y{background:#e0a92b}
  body[data-screen="play"] .bm-hpc.r{background:#c0392b}
  body[data-screen="play"] .bm-hpc.k{background:#6b6b6b}
  body[data-screen="play"] .bm-stc{display:grid;position:absolute;bottom:-7px;right:-7px;width:18px;height:18px;border-radius:50%;
    background:#e07b28;border:2px solid var(--ink);color:#fff;font-family:var(--disp);font-size:8px;place-items:center;z-index:3;cursor:pointer}
  body[data-screen="play"] .bench-mini.dead{filter:grayscale(1);opacity:.45}
  body[data-screen="play"] .piles{flex:0 0 56px;width:56px;display:flex;flex-direction:column;align-items:center;gap:4px}
  body[data-screen="play"] .deckstack{width:46px;height:62px}
  body[data-screen="play"] .discardpile{width:40px;height:32px}
  body[data-screen="play"] .hand-wrap{
    position:static!important;left:auto;right:auto;bottom:auto;top:auto;z-index:auto;
    display:flex;flex-direction:column;background:none;padding:0;flex:none;
  }
  body[data-screen="play"] .hand-toggle{display:none!important}
  body[data-screen="play"] .hand-wrap .hand,
  body[data-screen="play"] .hand-wrap.open .hand{
    display:flex!important;max-height:none;overflow:visible!important;
    justify-content:center;align-items:flex-end;gap:0;padding:6px 0 2px;background:none;border-top:none;box-shadow:none;
  }
  /* phone: shorter card, steeper fan, harder tuck. Shape and hover come from
     the shared computed rules -- only the tuning changes here. */
  /* phone typography only. Card height and fan tuning are set by the later
     block sharing this media query, which wins the cascade. */
  body[data-screen="play"] .hand .hc{padding:3px!important;font-size:7px}
  body[data-screen="play"] .hc-q,body[data-screen="play"] .hc-text{font-size:7px;line-height:1.1}
  body[data-screen="play"] .hc-name{font-size:8px}
  body[data-screen="play"] .hc-top,body[data-screen="play"] .hc-foot{font-size:6px}
  body[data-screen="play"] .topbar{padding:3px 6px}
  body[data-screen="play"] .topbar small{display:none}
  body[data-screen="play"] .logtoggle{transform:scale(.8);transform-origin:top right}
}
/* ---- Hand-card preview: tap to read it before playing ---- */
.hand-view{display:flex;flex-direction:column;align-items:center;gap:11px;max-height:92vh;overflow-y:auto;padding:4px}
.hv-card{display:block}                       /* NOT flex — .hc sizes by flex-basis, which was winning */
.hand-view .hc{
  flex:none!important;flex-basis:auto!important;                 /* the real size lever */
  width:min(86vw,290px)!important;min-width:0!important;
  height:auto!important;min-height:0!important;max-height:none!important;
  padding:14px!important;font-size:15px!important;
  opacity:1!important;filter:none!important;                     /* spent cards were 45% transparent */
  transform:none!important;cursor:default;pointer-events:none;
  box-shadow:0 14px 34px rgba(0,0,0,.6)!important;
  display:flex!important;flex-direction:column;gap:8px;overflow:visible!important;
}
.hand-view .hc-name{font-size:20px!important;line-height:1.2;white-space:normal!important}
.hand-view .hc-q,.hand-view .hc-text{font-size:15px!important;line-height:1.45;white-space:normal!important;
  -webkit-line-clamp:unset!important;overflow:visible!important;display:block!important}
.hand-view .hc-top,.hand-view .hc-foot{font-size:12px!important;letter-spacing:1px;opacity:1!important}
.hand-view .hc-art,.hand-view .hc img{max-width:100%;height:auto}
/* card details under the preview (crit passive/thesis/reward, bookmark effect) */
.hv-info{width:min(86vw,290px);display:flex;flex-direction:column;gap:7px}
.hvi-row{background:var(--cream);border:2.5px solid var(--ink);border-radius:9px;padding:8px 10px;
  box-shadow:0 3px 0 rgba(40,25,12,.45)}
.hvi-row b{display:block;font-family:var(--cond);font-size:11px;letter-spacing:.6px;text-transform:uppercase;
  color:#7a6a4a;margin-bottom:3px}
.hvi-row p{margin:0;font-family:Georgia,serif;font-size:13.5px;line-height:1.4;color:#241F1B}
.hvi-row.th{background:#f3ead4;border-color:#8a6a2a}
.hvi-row.th b{color:#8a6a2a}
.hvi-row.rw{background:#e8f2e8;border-color:#3f6b4a}
.hvi-row.rw b{color:#2d5a2d}
/* ================= TABLET (iPad): same single-screen UI, scaled up ================= */
