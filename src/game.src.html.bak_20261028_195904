  body[data-screen="play"] .hand .hc{padding:7px!important;font-size:11px!important}
  body[data-screen="play"] .hc-q,body[data-screen="play"] .hc-text{font-size:11px;line-height:1.25}
  body[data-screen="play"] .hc-name{font-size:12px}
  body[data-screen="play"] .hc-top,body[data-screen="play"] .hc-foot{font-size:9px}
