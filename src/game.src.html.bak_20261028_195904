/* Move the turn bar to wherever turnBarWhere() now says, touching nothing else. */
function refreshTurnBar(){
  const old=document.getElementById('turnclock');
  if(old){ const fl=old.closest('.turnbar-float'); (fl||old).remove(); }
  const where=turnBarWhere(); if(!where) return;
  if(where==='board'){
