function scrimRollEvent(){ const ids=Object.keys(SCRIM_EVENTS).filter(id=>(SCRIM._eventsSeen||[]).indexOf(id)<0); const pool=ids.length?ids:Object.keys(SCRIM_EVENTS); const id=pool[rnd(pool.length)]; SCRIM._eventsSeen=(SCRIM._eventsSeen||[]).concat(id); return id; }
function scrimEventScreen(){
  const ev=SCRIM_EVENTS[SCRIM.event]; if(!ev) return '<div class="scrim-wrap scrim-ink"><div class="scrim-panel">\u2014</div></div>';
  if(SCRIM._eventResult){
    return '<div class="scrim-wrap scrim-ink"><div class="scrim-panel evt"><div class="evt-ic">'+ev.ic+'</div><div class="scrim-title sm">'+ev.title+'</div><div class="evt-result">'+SCRIM._eventResult+'</div><button class="bigbtn go" data-scrim="evdone">Continue \u203a</button></div></div>';
  }
  const lf=SCRIM.lf||0;
  const choices=ev.choices.map((c,i)=>{ const afford=!c.need||lf>=c.need; return '<button class="evt-choice'+(afford?'':' evt-lock')+'" data-scrim="evchoose:'+i+'"'+(afford?'':' disabled')+'>'+c.label+(c.need?' <span class="evt-cost">('+c.need+' Late Fees)</span>':'')+'</button>'; }).join('');
  return '<div class="scrim-wrap scrim-ink"><div class="scrim-panel evt"><div class="evt-ic">'+ev.ic+'</div><div class="scrim-title sm">'+ev.title+'</div><div class="evt-lf">Late Fees: '+lf+'</div><p class="evt-text">'+ev.text+'</p><div class="evt-choices">'+choices+'</div></div></div>';
}
function scrimEventChoose(i){
  const ev=SCRIM_EVENTS[SCRIM.event]; if(!ev) return; const ch=ev.choices[i]; if(!ch) return;
  if(ch.need && (SCRIM.lf||0)<ch.need){ toast('Not enough Late Fees.'); return; }
  let msg='';
  const grantArt=(tiers)=>{ const id=scrimGrantArtifact(tiers||['common','uncommon']); return id?SCRIM_ART[id]:null; };
  switch(ch.fx){
    case 'leave': msg='You move on, unchanged.'; break;
    case 'vend': { const a=grantArt(); if(a){ SCRIM.lf-=ch.need; msg='The machine clunks and drops <b>'+a.ic+' '+a.name+'</b>.'; } else { msg='The machine is empty \u2014 you keep your Late Fees.'; } break; }
    case 'extra': { if(Math.random()<0.6){ if(Math.random()<0.5){ const a=grantArt(); if(a){ msg='Correct! You earn <b>'+a.ic+' '+a.name+'</b>.'; } else { META.ip=(META.ip||0)+15; metaSave(); msg='Correct! <b>+15 Intellect Points.</b>'; } } else { META.ip=(META.ip||0)+15; metaSave(); msg='Correct! <b>+15 Intellect Points.</b>'; } } else { SCRIM.team.forEach(t=>{ if(t.curHp>0) t.curHp=Math.max(1,t.curHp-15); }); msg='Wrong \u2014 the class groans. <b>Your team takes 15 damage.</b>'; } break; }
    case 'php': SCRIM.team.forEach(t=>{ t.maxHp+=10; if(t.curHp>0)t.curHp=Math.min(t.maxHp,t.curHp+10); }); msg='<b>+10 Max HP</b> to your whole roster.'; break;
    case 'pdraft': SCRIM._eventResult=null; SCRIM.event=null; SCRIM.draft=scrimRollDraft(3); SCRIM.view='archives'; render(); scrimSave(); return;
    case 'part': { const a=grantArt(); msg=a?('The professor hands you <b>'+a.ic+' '+a.name+'</b>.'):'You already own everything on offer.'; break; }
    case 'settle': SCRIM.lf-=ch.need; msg='Settled. The librarian nods approvingly.'; break;
    case 'curse': SCRIM.team.forEach(t=>{ t.maxHp=Math.max(20,t.maxHp-6); if(t.curHp>t.maxHp)t.curHp=t.maxHp; }); msg='The distraction lingers \u2014 <b>\u22126 Max HP</b> to your roster for the rest of the run.'; break;
    case 'swap': { const feids=feAll().map(f=>f.id).filter(id=>!SCRIM.team.some(t=>t.fe&&t.id===id)); if(!feids.length){ msg='No substitutes are available.'; break; } const feid=feids[rnd(feids.length)]; const fd=firstedById(feid); if(!fd){ msg='No substitutes are available.'; break; } const idx=SCRIM.team.findIndex(t=>!t.fe); const slot=idx>=0?idx:0; const mx=fd.hp||90; SCRIM.team[slot]={fe:true,id:feid,deck:fd.deck,curHp:mx,maxHp:mx}; if((META.commanders||[]).indexOf(feid)<0){ META.commanders.push(feid); metaSave(); } msg='A substitute steps in: <b>'+fd.name+'</b> joins your roster.'; break; }
    case 'lfcard': { const decks=Object.keys(DATA.characters); const d=decks[rnd(decks.length)]; const ci=rnd(DATA.abcs[d].length); SCRIM.deck.ab.push({d:d,i:ci}); const cd=DATA.abcs[d][ci]; msg='From the papers: a new <b>'+(cd?cd.type:'ABC')+'</b> card joins your deck.'; break; }
    case 'lfart': { const a=grantArt(); msg=a?('From the trinkets: <b>'+a.ic+' '+a.name+'</b>.'):'The trinket pile is bare.'; break; }
    case 'cram': SCRIM.team.forEach(t=>{ t.curHp=t.maxHp; }); SCRIM._noNextReward=true; msg='Rested and ready \u2014 <b>team healed to full.</b> (Your next Scrimmage gives no card.)'; break;
    case 'meat': { const r=rnd(3); if(r===0){ META.ip=(META.ip||0)+20; metaSave(); msg='Surprisingly good! <b>+20 Intellect Points.</b>'; } else if(r===1){ SCRIM.lf=(SCRIM.lf||0)+2; msg='You find a coupon inside. <b>+2 Late Fees.</b>'; } else { SCRIM.team.forEach(t=>{ if(t.curHp>0) t.curHp=Math.max(1,t.curHp-10); }); msg='\u2026that was a mistake. <b>Your team loses 10 HP.</b>'; } break; }
    case 'career': { const lf=SCRIM.lf||0; const ip=lf*3; META.ip=(META.ip||0)+ip; metaSave(); SCRIM.lf=0; msg='You cash out: <b>+'+ip+' Intellect Points</b> for '+lf+' Late Fees.'; break; }
  }
  SCRIM._eventResult=msg||'Done.'; render(); scrimSave();
}

function scrimResolveNode(c,r){
  const node=SCRIM.map.cols[c][r]; SCRIM.pending={c,r};
  if(node.type==='scrim'||node.type==='elite'||node.type==='boss'||node.type==='corrupted'){ scrimStartBattle(node); }
  else if(node.type==='archives'){ scrimAdvanceTo(c,r); SCRIM.pending=null; SCRIM.draft=scrimRollDraft(Math.max(2,(perkOn('officehours')?4:3)+honorsMods().draftDelta)); SCRIM.view='archives'; try{SFX.card('pack_open',0.7);}catch(e){} render(); scrimSave(); }
  else if(node.type==='rest'){ scrimAdvanceTo(c,r); SCRIM.pending=null; SCRIM.view='rest'; render(); scrimSave(); }
  else if(node.type==='fair'){ scrimAdvanceTo(c,r); SCRIM.pending=null; SCRIM.view='fair'; try{SFX.card('card_fan',0.6);}catch(e){} render(); scrimSave(); }
  else if(node.type==='office'){ scrimAdvanceTo(c,r); SCRIM.pending=null; SCRIM.event=scrimRollEvent(); SCRIM._eventResult=null; SCRIM.view='event'; try{SFX.card('card_fan',0.6);}catch(e){} render(); scrimSave(); }
}
function scrimAfterBattle(){
  if(!S) { SCRIM.view='map'; render(); return; }
  S.you.team.forEach(c=>{ if(c._scrimIdx!=null && SCRIM.team[c._scrimIdx]) SCRIM.team[c._scrimIdx].curHp=Math.max(0,c.hp); });
  const won = !S.opp.team.some(x=>x.hp>0);
  const node=S.scrim.node;
  if(!won){
    if(scrimHas('overdue') && !SCRIM._overdueUsed){ SCRIM._overdueUsed=true; SCRIM.team.forEach(t=>{ t.curHp=1; });
      if(node&&SCRIM.map){ const cell=SCRIM.map.cols?.[node.c]?.[node.r]; if(cell) cell.done=false; }
      S=null; stopTurnTimer(); APP.screen='scrim'; SCRIM.pending=null; SCRIM.view='map';
      toast('Overdue Notice \u2014 you survive at 1 HP. (once per run)','bad'); render(); scrimSave(); return; }
    if(SCRIM.doctoral){ scrimEndDoctoral(false); return; }
    if(honorsMods().permadeath){ scrimEndRun(false); return; }
    // Non-permadeath: regroup — team revives at 40% and returns to the map to retry.
    SCRIM.team.forEach(t=>{ t.curHp=Math.max(1,Math.round(t.maxHp*0.4)); });
    if(node&&SCRIM.map){ const cell=SCRIM.map.cols?.[node.c]?.[node.r]; if(cell) cell.done=false; }
    S=null; stopTurnTimer(); APP.screen='scrim'; SCRIM.pending=null; SCRIM.view='map';
    toast('The sector overwhelms you \u2014 your scholars regroup at 40% HP.','bad'); render(); scrimSave(); return;
  }
  const _lf = (node.boss?6:(node.type==='elite'?4:2)) + (perkOn('adjunct')?2:0) + (scrimHas('tenuretrack')?2:0);
  if(SCRIM.kit==='tewwg') SCRIM.team.forEach(t=>{ if(t.curHp>0) t.curHp=Math.min(t.maxHp,t.curHp+8); });
  SCRIM.lf=(SCRIM.lf||0)+_lf; SCRIM._lfGain=_lf;
  if(SCRIM.pending){ scrimAdvanceTo(SCRIM.pending.c,SCRIM.pending.r); }
  let art=null;
  if(node.type==='elite'||node.boss) art=scrimGrantArtifact(node.boss?['rare','boss']:['uncommon','rare']);
  SCRIM._gainedArt=art;
  if(node.corrupted){
    S=null; stopTurnTimer(); APP.screen='scrim';
    const fd=firstedById('otdesi_1e'); const mx=fd.hp||120;
    SCRIM.team.push({fe:true,id:'otdesi_1e',deck:fd.deck,curHp:mx,maxHp:mx});
    if((META.commanders||[]).indexOf('otdesi_1e')<0){ META.commanders.push('otdesi_1e'); }
    META.otdesiEarned=true; metaSave();
    SCRIM._corruptedWon=true; SCRIM._corruptedPos={c:SCRIM.pending.c,r:SCRIM.pending.r}; SCRIM.view='corruptedreward'; try{SFX.card('pack_take',0.8);}catch(e){} render(); scrimSave(); return;
  }
  if(node.superboss){
    META.stats.bossKills=(META.stats.bossKills||0)+1; META.overlordKilled=true; metaSave();
    S=null; stopTurnTimer(); APP.screen='scrim';
    scrimEndRun(true); return;
  }
  if(node.boss){
    META.stats.bossKills=(META.stats.bossKills||0)+1; if((META.bossKilled||[]).indexOf(node.boss)<0) META.bossKilled.push(node.boss); if((META.bossSeen||[]).indexOf(node.boss)<0) META.bossSeen.push(node.boss); metaSave();
    if(scrimHas('fellowship')){ SCRIM.team.forEach(t=>{ t.curHp=t.maxHp; }); }
    S=null; stopTurnTimer(); APP.screen='scrim';
    if(SCRIM.doctoral){
      const sem=SCRIM.semester||1;
      const ipGain=Math.round(40*(1+0.4*sem)*honorsMods().ipMul); META.ip=(META.ip||0)+ipGain; SCRIM._bossIP=ipGain; SCRIM._docTotal=(SCRIM._docTotal||0)+ipGain;
      SCRIM._tenureBonus=(SCRIM._tenureBonus||0)+Math.round(25*sem*honorsMods().ipMul);
      META.stats.doctoralBest=Math.max(META.stats.doctoralBest||0, sem); metaSave();
      SCRIM.pending=null; SCRIM.view='doctoralchoice'; try{SFX.card('card_fan',0.7);}catch(e){} render(); scrimSave(); return;
    }
    if((SCRIM.act||1)>=7){ scrimStartSuperBoss(); return; }
    const ipGain=Math.round(40*honorsMods().ipMul); META.ip=(META.ip||0)+ipGain; metaSave(); SCRIM._bossIP=ipGain;
    SCRIM.bossReward=scrimRollFirstEds(3); SCRIM.pending=null;
    SCRIM.view='bossreward'; try{SFX.card('card_fan',0.7);}catch(e){} render(); scrimSave(); return;
  }
  S=null; stopTurnTimer(); APP.screen='scrim';
  if(SCRIM._noNextReward){ SCRIM._noNextReward=false; SCRIM.pending=null; SCRIM.view='map'; toast('Too tired to take notes \u2014 no card this fight.'); render(); scrimSave(); return; }
  SCRIM.pending=null; SCRIM.draft=scrimRollDraft(Math.max(2,(perkOn('officehours')?4:3)+honorsMods().draftDelta)); SCRIM.view='reward'; try{SFX.card('card_fan',0.7);}catch(e){} render(); scrimSave();
}
function scrimBuyUnlock(id){
