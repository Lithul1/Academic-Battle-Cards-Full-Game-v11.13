/* Act card in hand: the target Act's frame. Same rules and markup hooks as actHandCard. */
function abcPfActHand(c,idx,straty,deal,_lk){
  if(!abcPfOn()) return '';
  const a=actById(c.actId); if(!a) return '';
  const D=PF_DECKS[a.deck]; if(!D||D.acts.indexOf(a.act)<0) return '';
  const you=S.you, pk=actPick(you,c), ok=straty && !drawnLocked() && !!pk.t;
  let img=a.img, pos=a.hpos||'50% 22%';
  if(!img){ const b=a.base&&DATA.characters[a.base[0]]&&DATA.characters[a.base[0]].find(function(x){ return x.id===a.base[1]; }); if(b&&b.img){ img=b.img; pos=b.imgpos||pos; } }
  const port=img?`<img class="hcc-img" src="${img}" alt="${abcPfEsc(a.name)}" style="object-position:${pos}">`
                :`<span class="hcc-mono" style="background:${a.accent||'#444'}">${initials(a.name)}</span>`;
  let met=false, cond='';
  if(a.plot==='hit'){ met=actTargets(you,a).some(function(t){ return t._tookHit; }); cond='Plot Point 1 · took damage '+(met?'✓':'✗'); }
  else { met=actTargets(you,a).length>0; cond='Plot Point 2 · climax or theme question'; }
  return `<div class="hc crit act-hc pf-hc ${ok?'playable':'spent'}${deal}${_lk}" data-idx="${idx}" title="${abcPfEsc(ok?'Tap to evolve':pk.why)}" style="--pf:var(--pf-${a.deck}-${a.act})">
      <div class="pfh-art">${port}</div>
      <div class="pfh-plate"><div class="hcc-nm">${abcPfEsc(a.name)}</div><div class="hcc-foot">Evolves from ${abcPfEsc(actStageName(a.from))}</div></div>
      <div class="act-cond ${met?'met':'unmet'}">${cond}</div></div>`;
}

