    if(acts) acts.insertAdjacentHTML('beforebegin', turnBarHtml());
  } else {
    const root=$('#game'); if(root) root.insertAdjacentHTML('beforeend', turnBarFloatHtml(where));
    placeTurnBar();
  }
}
