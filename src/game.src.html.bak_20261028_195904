  while(guard++<12){
    const need=!drawnHasActive(p); if(!need && drawnBench(p)>=ARENA_RULES.benchMax) return;
    let best=-1;
    p.hand.forEach(function(c,i){ if(!arenaCanField(p,c)) return; const cost=c._pmCmd?(c._pmCost||0):0; if(cost>p.attachesLeft) return;
      if(best<0 || (c.hp||0)>(p.hand[best].hp||0)) best=i; });
    if(best<0) return;
    const card=p.hand[best], cost=card._pmCmd?(card._pmCost||0):0;
