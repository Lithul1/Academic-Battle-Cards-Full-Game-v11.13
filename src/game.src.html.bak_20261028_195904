function paintAudioCtl(){ const m=document.getElementById('btnMus'), s=document.getElementById('btnSfx'); if(m) m.classList.toggle('off',!SFX.isMusicOn()); if(s){ s.classList.toggle('off',!SFX.isSfxOn()); s.textContent=SFX.isSfxOn()?'🔊':'🔇'; } }
function initAudioCtl(){
