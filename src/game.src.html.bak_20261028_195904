function ipAccept(picks){
  const st=S._ip; if(!st) return;
  const P=S[st.side], need=ipCost(st.side);
  const idxs=[].concat(picks).filter(i=>i!==st.pend.handIdx).slice(0,need);
  if(idxs.length<need){ toast('Choose '+need+' card'+(need===1?'':'s')+' to shed.'); return; }
