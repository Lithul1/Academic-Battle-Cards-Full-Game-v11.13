const STARTER_CR = [6,7,10,13];   // Archetypal, Formalism, Reader-Response, Biographical
function starterBm(i){ return STARTER_BM[+i]||0; }
function starterCr(i){ return STARTER_CR.indexOf(+i)>=0; }
function ownCrit(i){ return sbx() || starterCr(i) || (META.crits||[]).indexOf(+i)>=0; }
function bmOwned(i){ return sbx() ? window.BM_MAX_COPIES : Math.max(starterBm(i), (META.bmCopies||{})[i]||0); }

/* ---- Locked decks: license + starter kit ---- */
window.LOCKED_DECKS=['sherlock','othello','wonderland'];
