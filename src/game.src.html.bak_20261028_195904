const ABM_TAGTXT={plotarmor:'immune to all damage',cliffhanger:'nobody drops below 1 HP',censorship:'no Bookmarks',extracredit:'KO this turn → draw 2',antiq:'+30 atk / +10 blk',supercharge:'next attack ×2',dogear:'keeps Attack ABC',cliffnotes:'next ABC: no trivia',truce:"foe's next attack skipped",highlight:'+20 next attack',marginNotes:'draw on next attach',ironcurtain:'blocks next attack',hardcover:'−10 incoming',laminate:'immune to T/R/G/S'};
function activeBmZone(p){
  if(!p.activeBm||!p.activeBm.length) return '';
  const chips=p.activeBm.map(c=>`<div class="abm-card" title="${(c.name+' — '+(c.text||'')).replace(/"/g,'&quot;')}"><span class="abm-nm">✦ ${c.name}</span><span class="abm-tag">${c._tag==='saga'?('Ch. '+roman(c._stage||0)+' / '+((c.stages||[]).length)):(ABM_TAGTXT[c._tag]||'in play')}</span></div>`).join('');
  return `<div class="abm-zone" title="Active bookmarks — effects in play, awaiting their trigger"><div class="abm-label">Active ✦ ${p.activeBm.length}</div>${chips}</div>`;
}
function sweepActiveBm(p){
  if(!p||!p.activeBm||!p.activeBm.length) return;
  const foe=(p===S.you?S.opp:S.you);
  const statusTags=['highlight','marginNotes','ironcurtain','hardcover','laminate','plotarmor','antiq'];
  const keep=[];
  p.activeBm.forEach(card=>{
    const t=card._tag; let on;
    if(statusTags.includes(t)){ const c=p.team.find(x=>x.uid===card._uid); on=!!(c&&c.hp>0&&c.status[t]); }
    else if(t==='supercharge') on=!!p.flags.supercharge;
    else if(t==='dogear') on=!!p.flags.dogear;
    else if(t==='cliffnotes') on=!!p.flags.skipTrivia;
    else if(t==='truce') on=!!(foe&&foe.flags.truce);
    else if(t==='censorship') on=(S._censor||0)>0;
    else if(t==='cliffhanger') on=(S._cliffhanger||0)>0;
    else if(t==='extracredit') on=!!p.flags.extracredit;
    else if(t==='saga') on=!!(card.stages && (card._stage||0)<card.stages.length);
    else on=false;
    if(on) keep.push(card); else { delete card._tag; delete card._uid; delete card._stage; p.discard.push(card); }
  });
