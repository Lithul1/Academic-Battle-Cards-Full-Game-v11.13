/* ---- AI fielding: an Active if it has none (highest HP), then Backstage up to the limit.
       One copy per character; a returned commander only if its attach cost is affordable. ---- */
function arenaCanField(p,card){ if(!card||card.cat!=='char') return false; if(card._offTurn!=null && card._offTurn===(S._turnNo||0)) return false;
  const k=card.fe?((card._cdef&&card._cdef.base)||[])[1]:card.charId;
