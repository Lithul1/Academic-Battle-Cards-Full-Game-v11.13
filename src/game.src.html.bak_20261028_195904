function deckLocked(k){ return (window.LOCKED_DECKS||[]).indexOf(k)>=0; }
function deckUnlocked(k){ return sbx() || !deckLocked(k) || (META.decks||[]).indexOf(k)>=0; }
function feOwned(id){
