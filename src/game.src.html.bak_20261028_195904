/* The floating turn bar tucks in just under the top bar, flush with its left
   or right edge. The top bar's height and width change with the layout (it
   wraps on phones), so this is measured rather than hardcoded -- a fixed
   offset put the bar over the title and the Tune / Menu buttons. */
function placeTurnBar(){
  const fl=document.querySelector('.turnbar-float'), tb=document.querySelector('body[data-screen="play"] .topbar');
  if(!fl||!tb) return;
  const r=tb.getBoundingClientRect(), top=Math.max(6, Math.round(r.bottom+6));
  /* the Log toggle is pinned top-right in the same row, so Top right stops
     short of it rather than sitting on top of it */
  let right=r.right;
  const lg=document.querySelector('.logtoggle'), lr=lg&&lg.getBoundingClientRect();
  if(lr && lr.width && lr.top < top+fl.offsetHeight && lr.bottom > top) right=Math.min(right, lr.left-6);
  fl.style.setProperty('--tbf-top', top+'px');
  fl.style.setProperty('--tbf-left', Math.max(6, Math.round(r.left))+'px');
  fl.style.setProperty('--tbf-right', Math.max(6, Math.round(window.innerWidth-right))+'px');
}
