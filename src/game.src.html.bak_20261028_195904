  // or attach() will reach for the wrong card once the hand has closed up.
  idxs.sort((a,b)=>b-a).forEach(i=>{
    const c=P.hand.splice(i,1)[0]; if(c) P.discard.push(c);
    if(i < st.pend.handIdx) st.pend.handIdx--;
