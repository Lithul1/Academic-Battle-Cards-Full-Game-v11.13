function siphonOwner(sp){ if(!sp||!sp.own) return null;
  const P=S&&S[sp.own.side]; if(!P) return null;
  const c=P.team&&P.team[sp.own.idx];
  return (c&&c.hp>0&&P.team[P.activeIdx]===c)?{P,c}:(c&&c.hp>0?{P,c}:null); }
function applySiphon(target,owner,ownerSide,cfg){
  if(!target||target.hp<=0) return false;
  if(target.status.laminate){ pushLog(`${target.name} is Laminated \u2014 the siphon finds no purchase.`); return false; }
  const P=S[ownerSide], idx=P.team.indexOf(owner);
  const prev=target.status.siphon;
  const amt=(cfg&&cfg.amt)||10;
  target.status.siphon={amt, leech:(cfg&&cfg.leech!=null)?cfg.leech:Math.floor(amt/2),
    turns:(cfg&&cfg.turns)||2, mode:(cfg&&cfg.mode)||'hp', own:{side:ownerSide,idx}};
  pushLog(prev?`Siphon on ${target.name} is renewed \u2014 duration refreshed, drain unchanged.`
              :`\u2604 ${target.name} is Siphoned \u2014 ${amt} per turn.`);
  if(typeof fxStatus==='function'){ try{ fxStatus(sideOfChar?sideOfChar(target):null,'siphon'); }catch(e){} }
  return true; }
