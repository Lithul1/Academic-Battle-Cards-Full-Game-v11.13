.bst-ab.atk{ background:#f4d3d0; color:#8a2b2b; } .bst-ab.blk{ background:#d0dcf4; color:#2b4a8a; }
.bst-lab{ font-weight:bold; float:right; }
.bst-lore{ border-top:2px dashed #c9b58a; padding-top:9px; font-size:13px; line-height:1.5; color:#3a322b; }
.bst-lh{ font-family:var(--cond); letter-spacing:1px; font-size:11px; color:#8a5a1a; text-transform:uppercase; display:block; margin-bottom:3px; }
.bst-lore.locked{ color:#9a8a6a; font-style:italic; }
.bst-altdot{ position:absolute; top:3px; right:4px; font-size:11px; color:#1f6a3a; text-shadow:0 0 3px #fff; }
.bst-alt{ margin-top:10px; border-top:2px dashed #b9a06a; padding-top:9px; }
.bst-alth{ font-family:var(--cond); letter-spacing:.8px; font-size:12px; color:#1f6a3a; text-transform:uppercase; margin-bottom:6px; }
.bst-altart{ width:100%; max-height:180px; object-fit:cover; object-position:50% 22%; border:2px solid #241f1b; border-radius:8px; margin-bottom:7px; }
