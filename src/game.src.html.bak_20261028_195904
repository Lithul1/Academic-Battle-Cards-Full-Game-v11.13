  const oppDef=(APP.mode==='quick'||APP.youDeck==='surprise')?randomDeck(st.oppSet):defaultDeck(st.oppSet);
  oppDef.bm=buildOppBookmarks(diff);   // opponent bookmarks stay difficulty-tuned for challenge
  newGame(st, youDef, oppDef);
}
